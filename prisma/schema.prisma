generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model Zone {
  id         String   @id @default(cuid())
  shopDomain String
  name       String
  zipCodes   String   @db.Text
  status     String   @default("enabled")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rates      Rate[]

  @@index([shopDomain])
}

model Rate {
  id          String   @id @default(cuid())
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String   @default("price")
  minValue    Float    @default(0)
  maxValue    Float?
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId])
}

model CarrierService {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  serviceId   String
  callbackUrl String   @default("")   // stored so we detect URL changes (tunnel restarts)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
